# FINA.AI — optional environment variables
#
# The app runs with NO env vars at all: the AI Insight Panel falls back to
# rule-based insights automatically. Set the variables below only if you want
# the panel to be generated by a live LLM.

# Shared API key for the LLM provider (OpenAI, DeepSeek, or any OpenAI-compatible gateway).
AI_API_KEY=

# Optional: override the OpenAI-compatible base URL.
#   OpenAI   -> https://api.openai.com/v1        (default)
#   DeepSeek -> https://api.deepseek.com/v1
AI_BASE_URL=

# Optional: override the model name.
#   OpenAI   -> gpt-4o-mini                      (default)
#   DeepSeek -> deepseek-chat
AI_MODEL=
